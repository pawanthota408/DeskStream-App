<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="133dp"
    android:viewportWidth="360"
    android:viewportHeight="240">

    <!-- Primary Top Left Wave -->
    <path
        android:pathData="M -20,-20 H 260 C 200,60 120,120 -20,160 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="200"
                android:endY="150"
                android:type="linear">
                <item android:color="#FF1A24" android:offset="0.0" />
                <item android:color="#DC2626" android:offset="0.6" />
                <item android:color="#E53E3E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Secondary Soft Wave Layer -->
    <path
        android:pathData="M -20,-20 H 220 C 170,80 80,140 -20,200 Z"
        android:fillColor="#33FF2020" />

    <!-- Thin White Stroke Accent -->
    <path
        android:pathData="M -20,160 C 120,120 200,60 260,-20"
        android:strokeColor="#AAFFFFFF"
        android:strokeWidth="1.5" />
</vector>
