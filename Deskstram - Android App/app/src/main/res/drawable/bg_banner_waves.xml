        android:pathData="M 240,220 C 300,120 350,50 420,0 V 220 Z"
        android:fillColor="#15E50914" />

    <!-- Fine Red Accent Stroke Lines -->
    <path
        android:pathData="M -20,170 C 120,210 260,180 420,50"
        android:strokeColor="#33DC2626"
        android:strokeWidth="1.5" />

    <path
        android:pathData="M 180,220 C 260,140 320,80 420,10"
        android:strokeColor="#33DC2626"
        android:strokeWidth="1.5" />

