<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for DeskStream Android App.
    - Allows cleartext (HTTP) traffic ONLY to localhost for local dev.
    - All production traffic to friendssoftwaresolutions.in uses HTTPS (default trust).
-->
<network-security-config>
    <!-- Production HTTPS server: trust default CAs -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">friendssoftwaresolutions.in</domain>
    </domain-config>

    <!-- Local development server: allow HTTP to localhost / 10.0.2.2 (emulator alias) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
    </domain-config>
</network-security-config>
